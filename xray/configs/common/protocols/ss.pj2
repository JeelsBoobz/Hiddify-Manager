"protocol": "shadowsocks",
"settings": {
    "clients":[
        {% for u in users %}
            {"password": "{{ u['uuid'] }}", "email": "{{ u['uuid'] }}@hiddify.com","method": "Chacha20-IETF-Poly1305"{% if u['uuid'] != '00000000-0000-0000-0000-000000000000' %},"limitIp": 2{% endif %}},
        {% endfor %}
    ]
}