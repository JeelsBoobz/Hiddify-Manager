"protocol": "vless",
"settings": {
    "clients": [
        {% for u in users %}
            {
                "id": "{{ u['uuid'] }}", 
                "email": "{{ u['uuid'] }}@hiddify.com",
                "flow": "{{flow}}"{% if u['uuid'] != '00000000-0000-0000-0000-000000000000' %},"limitIp": 2{% endif %}
            },
        {% endfor %}
    ],
    "decryption": "none",
    "fallbacks": [   
        {
            "dest": "@@http_in_h2", //redirect to haproxy
            "xver": 2
        }
    ]
}